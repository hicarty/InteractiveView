@{
    ViewData["Title"] = "Green Cube";
}

<div class="green-cube-scene">
    <canvas id="GreenCubeCanvas" touch-action="none"></canvas>
</div>

@section scripts{
    <script src="~/js/greencube.js" asp-append-version="true"></script>
    <script>
        $(function () {
            IntereactiveView.GreenCube.Setup(document.getElementById("GreenCubeCanvas"));
        });
    </script>
}